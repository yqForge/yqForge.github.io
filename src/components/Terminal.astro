<script>
  const sleep = (duration: number) =>
    new Promise<void>((resolve) => window.setTimeout(resolve, duration));

  const typeText = async (element: HTMLElement, text: string) => {
    for (const character of text) {
      element.textContent += character;

      const delay =
        character === " "
          ? 25 + Math.random() * 25
          : 42 + Math.random() * 48;
      await sleep(delay);
    }
  };

  const animateTerminal = async (terminal: HTMLElement) => {
    if (terminal.dataset.animated === "true") return;
    terminal.dataset.animated = "true";

    const lines = Array.from(
      terminal.querySelectorAll<HTMLElement>("[data-terminal-line]")
    );
    const outputs = Array.from(
      terminal.querySelectorAll<HTMLElement>("[data-terminal-output]")
    );
    const finalPrompt = terminal.querySelector<HTMLElement>(
      "[data-terminal-final]"
    );

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.remove("terminal-animation-ready");
      return;
    }

    const commands = lines.map((line) =>
      Array.from(
        line.querySelectorAll<HTMLElement>("[data-terminal-typed]")
      ).map((part) => ({ element: part, text: part.textContent ?? "" }))
    );

    [...lines, ...outputs, ...(finalPrompt ? [finalPrompt] : [])].forEach(
      (element) => {
        element.hidden = true;
      }
    );
    commands.flat().forEach(({ element }) => {
      element.textContent = "";
    });

    document.documentElement.classList.remove("terminal-animation-ready");
    await sleep(350);

    for (const [index, line] of lines.entries()) {
      line.hidden = false;
      const cursor = line.querySelector<HTMLElement>(
        "[data-terminal-cursor]"
      );
      if (cursor) cursor.hidden = false;

      for (const { element, text } of commands[index]) {
        await typeText(element, text);
      }

      await sleep(260);
      if (cursor) cursor.hidden = true;

      const output = outputs[index];
      if (output) {
        output.hidden = false;
        output.classList.add("terminal-output-enter");
      }
      await sleep(480);
    }

    if (finalPrompt) finalPrompt.hidden = false;
  };

  document
    .querySelectorAll<HTMLElement>("[data-terminal]")
    .forEach((terminal) => void animateTerminal(terminal));
</script>

<style>
  :global(.terminal-animation-ready) [data-terminal-line],
  :global(.terminal-animation-ready) [data-terminal-output],
  :global(.terminal-animation-ready) [data-terminal-final] {
    visibility: hidden;
  }

  .terminal-output-enter {
    animation: terminal-output-in 180ms ease-out both;
  }

  @keyframes terminal-output-in {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
  }
</style>

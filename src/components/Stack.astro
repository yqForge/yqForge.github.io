---
import { skillGroups } from "../data/skills";

const groupAccents = [
  {
    bar: "from-emerald-400 to-teal-500",
    icon: "bg-emerald-100 text-emerald-600 dark:bg-emerald-500/15 dark:text-emerald-300",
    chip: "border-emerald-200/80 text-emerald-700 dark:border-emerald-500/25 dark:text-emerald-300",
  },
  {
    bar: "from-sky-400 to-indigo-500",
    icon: "bg-sky-100 text-sky-600 dark:bg-sky-500/15 dark:text-sky-300",
    chip: "border-sky-200/80 text-sky-700 dark:border-sky-500/25 dark:text-sky-300",
  },
  {
    bar: "from-violet-400 to-fuchsia-500",
    icon: "bg-violet-100 text-violet-600 dark:bg-violet-500/15 dark:text-violet-300",
    chip: "border-violet-200/80 text-violet-700 dark:border-violet-500/25 dark:text-violet-300",
  },
];
---

<section id="stack" class="reveal py-12 sm:py-16">
  <p class="text-sm font-medium tracking-wide text-indigo-600 dark:text-indigo-400">技术栈</p>
  <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">Technical Stack</h2>
  <p class="mt-3 max-w-2xl text-sm leading-6 text-zinc-500 dark:text-zinc-400">
    只列出当前工作或项目里能展开说明的部分。
  </p>
  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {skillGroups.map((group, index) => (
      <article class="group relative overflow-hidden rounded-2xl border border-zinc-200 bg-white p-5 transition duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-zinc-800 dark:bg-zinc-950">
        <div class:list={["absolute inset-x-0 top-0 h-1 bg-gradient-to-r opacity-80", groupAccents[index % groupAccents.length].bar]}></div>
        <div class="flex items-center gap-2.5 pt-1">
          <span class:list={["flex size-7 items-center justify-center rounded-lg", groupAccents[index % groupAccents.length].icon]}>
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M16 18l6-6-6-6M8 6l-6 6 6 6"></path>
            </svg>
          </span>
          <h3 class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{group.title}</h3>
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          {group.items.map((item) => (
            <span class:list={["rounded-full border bg-white px-2.5 py-1 text-xs dark:bg-transparent", groupAccents[index % groupAccents.length].chip]}>
              {item}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>

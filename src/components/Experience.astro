---
import { experience } from "../data/experience";
---

<section id="experience" class="reveal py-12 sm:py-16">
  <p class="text-sm font-medium tracking-wide text-indigo-600 dark:text-indigo-400">经历</p>
  <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">Experience</h2>
  <ol class="mt-10 space-y-8">
    {experience.map((item) => (
      <li class="relative overflow-hidden rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950">
        <div class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-indigo-500 via-violet-500 to-cyan-400"></div>
        <div class="flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-600 ring-1 ring-indigo-200/70 dark:bg-indigo-500/10 dark:text-indigo-300 dark:ring-indigo-500/30">
            {item.period}
          </span>
          <span class="text-xs text-zinc-400 dark:text-zinc-500">{item.location}</span>
        </div>
        <h3 class="mt-3 text-lg font-medium text-zinc-900 dark:text-zinc-50">{item.title}</h3>
        <ul class="mt-4 grid gap-2 text-sm leading-6 text-zinc-600 sm:grid-cols-2 dark:text-zinc-400">
          {item.highlights.map((line) => (
            <li class="flex items-start gap-2">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-gradient-to-r from-indigo-500 to-violet-500"></span>
              {line}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</section>

---
import { profile } from "../data/profile";

const chipStyles = [
  "border-violet-200 bg-violet-50 text-violet-700 dark:border-violet-500/30 dark:bg-violet-500/10 dark:text-violet-300",
  "border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-500/30 dark:bg-cyan-500/10 dark:text-cyan-300",
];
---

<section id="about" class="reveal py-12 sm:py-16">
  <p class="text-sm font-medium tracking-wide text-indigo-600 dark:text-indigo-400">关于</p>
  <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">About</h2>
  <div class="mt-8 max-w-2xl space-y-4 text-base leading-7 text-zinc-600 dark:text-zinc-400">
    {profile.about.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <div class="mt-8 flex flex-wrap gap-2">
    {profile.exploring.map((item, index) => (
      <span class:list={["inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm", chipStyles[index % chipStyles.length]]}>
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"></path>
        </svg>
        正在探索 · {item}
      </span>
    ))}
  </div>
</section>

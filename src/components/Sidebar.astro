---
import { profile } from "../data/profile";
---

<aside class="lg:sticky lg:top-24 lg:self-start">
  <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
    <div class="relative">
      <div class="rounded-full bg-gradient-to-br from-indigo-500 via-violet-500 to-cyan-400 p-1 shadow-xl shadow-indigo-500/20">
        {profile.photo ? (
          <img
            src={profile.photo}
            alt={`${profile.name} 的照片`}
            class="size-44 rounded-full object-cover ring-4 ring-white sm:size-52 lg:size-56 dark:ring-zinc-950"
          />
        ) : (
          <div class="flex size-44 items-center justify-center rounded-full bg-white text-3xl font-semibold tracking-wide text-zinc-800 ring-4 ring-white sm:size-52 lg:size-56 dark:bg-zinc-900 dark:text-zinc-100 dark:ring-zinc-950">
            {profile.initials}
          </div>
        )}
      </div>
      <span
        class="absolute bottom-3 right-3 flex size-6 items-center justify-center rounded-full bg-emerald-500 ring-4 ring-white dark:ring-zinc-950"
        title="在线可联系"
      >
        <span class="size-2 rounded-full bg-white"></span>
      </span>
    </div>

    <h1 class="mt-5 text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
      {profile.name}
    </h1>
    <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{profile.title}</p>

    <div class="mt-5 flex w-full max-w-56 flex-col gap-2 lg:max-w-none">
      <a
        href="#contact"
        class="inline-flex h-10 items-center justify-center rounded-full bg-gradient-to-r from-indigo-600 to-violet-600 text-sm font-medium text-white shadow-lg shadow-indigo-500/25 transition hover:opacity-90"
      >
        联系我
      </a>
      <a
        href={profile.github}
        target="_blank"
        rel="noreferrer"
        class="inline-flex h-10 items-center justify-center gap-2 rounded-full border border-zinc-300 text-sm font-medium text-zinc-800 transition hover:border-zinc-400 dark:border-zinc-700 dark:text-zinc-100 dark:hover:border-zinc-500"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.1 11.1 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .3.2.66.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"></path>
        </svg>
        GitHub
      </a>
    </div>

    <ul class="mt-6 w-full space-y-3 text-sm text-zinc-600 dark:text-zinc-400">
      <li class="flex items-center gap-2.5">
        <svg class="size-4 shrink-0 text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {profile.location}
      </li>
      <li class="flex items-center gap-2.5">
        <svg class="size-4 shrink-0 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="2" y="7" width="20" height="14" rx="2"></rect>
          <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path>
        </svg>
        Android Framework · AMS / WMS / PMS / NFC
      </li>
      <li class="flex items-center gap-2.5">
        <svg class="size-4 shrink-0 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"></path>
        </svg>
        探索 Agent 工作流 · AI Infra
      </li>
      <li class="flex items-center gap-2.5">
        <svg class="size-4 shrink-0 text-zinc-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.1 11.1 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .3.2.66.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"></path>
        </svg>
        <a href={profile.github} target="_blank" rel="noreferrer" class="transition hover:text-indigo-500">
          @{profile.githubUser}
        </a>
      </li>
    </ul>

    <div class="mt-6 w-full border-t border-zinc-200 pt-4 text-xs leading-5 text-zinc-500 dark:border-zinc-800 dark:text-zinc-500">
      可交流：项目开发 / 课程设计 / 项目指导
    </div>
  </div>
</aside>

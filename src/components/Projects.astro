---
import { projects } from "../data/projects";

const accents: Record<string, { bar: string; chip: string; glow: string }> = {
  "enterprise-ops": {
    bar: "from-indigo-500 via-violet-500 to-fuchsia-400",
    chip: "bg-indigo-50 text-indigo-600 ring-indigo-200/70 dark:bg-indigo-500/10 dark:text-indigo-300 dark:ring-indigo-500/30",
    glow: "hover:shadow-indigo-500/10",
  },
  "cultural-miniapp": {
    bar: "from-emerald-400 via-teal-400 to-cyan-400",
    chip: "bg-emerald-50 text-emerald-600 ring-emerald-200/70 dark:bg-emerald-500/10 dark:text-emerald-300 dark:ring-emerald-500/30",
    glow: "hover:shadow-emerald-500/10",
  },
  "off-work-countdown": {
    bar: "from-amber-400 via-orange-400 to-rose-400",
    chip: "bg-amber-50 text-amber-600 ring-amber-200/70 dark:bg-amber-500/10 dark:text-amber-300 dark:ring-amber-500/30",
    glow: "hover:shadow-amber-500/10",
  },
};

const fallback = accents["enterprise-ops"];
---

<section id="projects" class="reveal py-12 sm:py-16">
  <p class="text-sm font-medium tracking-wide text-indigo-600 dark:text-indigo-400">项目</p>
  <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">Selected Projects</h2>
  <p class="mt-3 max-w-2xl text-sm leading-6 text-zinc-500 dark:text-zinc-400">
    只展示有代表性的作品。商业项目已脱敏，源码默认不开源。
  </p>
  <div class="mt-10 grid gap-5 lg:grid-cols-2">
    {projects.map((project) => (
      <article
        class:list={[
          "group relative overflow-hidden rounded-2xl border border-zinc-200 bg-white p-6 pt-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-zinc-800 dark:bg-zinc-950",
          accents[project.slug]?.glow ?? fallback.glow,
          project.featured && "lg:col-span-2",
        ]}
      >
        <div
          class:list={[
            "absolute inset-x-0 top-0 h-1 bg-gradient-to-r",
            accents[project.slug]?.bar ?? fallback.bar,
          ]}
        ></div>
        <div class:list={["flex flex-col gap-5", project.featured && "lg:flex-row lg:items-start"]}>
          <div
            class:list={[
              "flex min-h-36 items-center justify-center rounded-xl border border-dashed border-zinc-200 bg-zinc-50 text-sm text-zinc-400 dark:border-zinc-800 dark:bg-zinc-900/40 dark:text-zinc-500",
              project.featured ? "lg:w-72 lg:shrink-0" : "",
            ]}
          >
            {project.image ? (
              <img src={project.image} alt={`${project.title} 截图`} class="h-full w-full rounded-xl object-cover" />
            ) : (
              <span>截图待补充</span>
            )}
          </div>
          <div class="min-w-0 flex-1">
            <p>
              <span class:list={["rounded-full px-2.5 py-1 text-xs font-medium ring-1", accents[project.slug]?.chip ?? fallback.chip]}>
                {project.category}
              </span>
            </p>
            <h3 class="mt-1 text-xl font-medium text-zinc-900 dark:text-zinc-50">{project.title}</h3>
            <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{project.description}</p>
            <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">职责：{project.role}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.techStack.map((tech) => (
                <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs text-zinc-600 dark:bg-zinc-900 dark:text-zinc-400">
                  {tech}
                </span>
              ))}
            </div>
            <div class="mt-5">
              {project.github ? (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noreferrer"
                  class="text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400"
                >
                  GitHub
                </a>
              ) : (
                <span class="text-sm text-zinc-400 dark:text-zinc-600">{project.sourceNote ?? "源码不开源"}</span>
              )}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
